{
  "name": "dadebertolino/db-event-manager",
  "description": "DB Event Manager plugin for WordPress",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "phpcs": "phpcs",
    "check-js": "node bin/check-js.js"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  }
}
